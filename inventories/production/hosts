# Production — dev servers
# Run: ansible-playbook site.yml -i inventories/production/hosts
# ansible_host is defined per-host in host_vars/

[dev_servers]
dev-server-01

[dev_servers:vars]
ansible_user                 = ansible
ansible_ssh_private_key_file = ~/.ssh/ansible_id_ed25519
ansible_python_interpreter   = /usr/bin/python3
