# Staging — mirrors production structure; update hosts before use
# Run: ansible-playbook site.yml -i inventories/staging/hosts

[dev_servers]
# dev-server-staging ansible_host=<staging-ip>

[dev_servers:vars]
ansible_user                 = ansible
ansible_ssh_private_key_file = ~/.ssh/ansible_id_ed25519
ansible_python_interpreter   = /usr/bin/python3
ansible_become_password = {{ vault_become_pass }}
